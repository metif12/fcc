# build.blip: declarative build (like build.zig steps, but data).
# Run with: fcc build [task]
# A task naming `outputs` is skipped when every output is newer than every
# input (`task x (up to date)`); `fcc build --force` bypasses the check.

task "build" {
  inputs = ["main.c"]
  outputs = ["main.s"]
  run = "fcc -S -o main.s main.c"
  depends = []
}

task "tokens" {
  inputs = ["main.c"]
  run = "fcc --dump-tokens main.c"
  depends = []
}

task "all" {
  run = "echo done"
  depends = ["build", "tokens"]
}
